# Build-time environment for the company build platform.
#
# These values only satisfy `web/src/env.mjs` validation during
# `next build`. The standalone server reads runtime env from the
# process environment (pm2 / web.env on 10.105.36.51), NOT from
# this file. Never put real secrets here.
#
# Copied to `.env` by the ant build script (see prepare-env).
# NEXTAUTH_URL should be the real public URL: it can be inlined
# into prerendered static pages at build time.
DATABASE_URL=postgresql://langfuse:dummy@127.0.0.1:5432/langfuse
NEXTAUTH_SECRET=build-time-placeholder-not-used-at-runtime
NEXTAUTH_URL=http://10.105.36.51:3000
SALT=build-time-placeholder-salt-not-used-at-runtime
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=dummy
